# ══════════════════════════════════════════════════════════
# Variables de entorno del SIEM — Plantilla sin valores reales
# Copiá este archivo como .env y completá los valores
# ══════════════════════════════════════════════════════════

# URL pública de n8n para webhooks de Telegram.
# Cambiar SOLO esta línea cada vez que reiniciés ngrok.
# Sin ngrok (solo motor ML): usar http://localhost:5678
N8N_WEBHOOK_URL=https://tu-url-ngrok.ngrok-free.dev

# Credenciales PostgreSQL
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=tesis_siem

# Credenciales servidor víctima SSH (pruebas RU-1)
SSH_USER=admin
SSH_PASSWORD=cambiar_esta_password

# ── NUEVO ──────────────────────────────────────────────────
# Key de AbuseIPDB (https://www.abuseipdb.com/account/api).
# NUNCA la pegues directamente en un workflow JSON: el workflow
# la lee de acá vía {{ $env.ABUSEIPDB_KEY }}.
ABUSEIPDB_KEY=tu_key_de_abuseipdb_aca

# Chat ID de Telegram al que se manda la alerta RU-4 en tiempo real
# (el reporte diario RU-5 sí es multiusuario, ver analistas_registrados).
# Para obtenerlo: hablale a tu bot y consultá
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID_DEFAULT=tu_chat_id_aca

# ══════════════════════════════════════════════════════════
# Variables de entorno del SIEM — Plantilla sin valores reales
# Copiá este archivo como .env y completá los valores
# ══════════════════════════════════════════════════════════

# URL pública de n8n para webhooks de Telegram.
# Cambiar SOLO esta línea cada vez que reiniciés ngrok.
# Sin ngrok (solo motor ML): usar http://localhost:5678
N8N_WEBHOOK_URL=https://tu-url-ngrok.ngrok-free.dev

# Credenciales PostgreSQL
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=tesis_siem

# Credenciales servidor víctima SSH (pruebas RU-1)
SSH_USER=admin
SSH_PASSWORD=cambiar_esta_password

# ── NUEVO ──────────────────────────────────────────────────
# Key de AbuseIPDB (https://www.abuseipdb.com/account/api).
# NUNCA la pegues directamente en un workflow JSON: el workflow
# la lee de acá vía {{ $env.ABUSEIPDB_KEY }}.
ABUSEIPDB_KEY=tu_key_de_abuseipdb_aca

# Chat ID de Telegram al que se manda la alerta RU-4 en tiempo real
# (el reporte diario RU-5 sí es multiusuario, ver analistas_registrados).
# Para obtenerlo: hablale a tu bot y consultá
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID_DEFAULT=tu_chat_id_aca

# ── HARDENING (Sección 4.3 tesis) ───────────────────────────
# Autenticación nativa de Grafana (GF_SECURITY_ADMIN_USER/PASSWORD)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esta_password

# Basic auth de n8n (protege la UI/API, no los webhooks públicos)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar_esta_password

# Password del usuario built-in "elastic" (xpack.security + TLS en ES)
ELASTIC_PASSWORD=cambiar_esta_password

# Password del usuario built-in "kibana_system" — Kibana NO puede usar
# "elastic" directo (xpack lo rechaza por ser superusuario). Setear con:
#   curl -k -u elastic:$ELASTIC_PASSWORD -X POST \
#     https://localhost:9200/_security/user/kibana_system/_password \
#     -H "Content-Type: application/json" -d '{"password":"..."}'
KIBANA_SYSTEM_PASSWORD=cambiar_esta_password

# Password del rol Postgres restringido de auditoría (solo INSERT/SELECT
# sobre las tablas alertas_*, sin UPDATE/DELETE por trigger; ver
# init_db/02_rol_auditoria.sql)
APP_AUDITORIA_PASSWORD=cambiar_esta_password

# ── Comparación empírica motor propio vs. Splunk Free ───────
# Password del usuario admin de Splunk (mín. 8 caracteres, mayúscula +
# minúscula + número).
SPLUNK_PASSWORD=cambiar_esta_password
# Token del HTTP Event Collector — Logstash lo usa para reenviar eventos.
# Generalo con: python3 -c "import uuid; print(uuid.uuid4())"
SPLUNK_HEC_TOKEN=cambiar_este_token
